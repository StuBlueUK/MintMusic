{
  "name": "mintmusic",
  "version": "0.2.0",
  "description": "MintMusic - audio-only YouTube music player for Linux Mint",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --linux deb --publish never"
  },
  "author": "",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "abstract-socket@2.1.1": true
  },
  "build": {
    "appId": "uk.co.stubblue.mintmusic",
    "productName": "MintMusic",
    "icon": "assets/icon.png",
    "files": [
      "*.js",
      "*.html",
      "*.css",
      "assets/**/*"
    ],
    "linux": {
      "target": [
        "deb"
      ],
      "category": "AudioVideo",
      "maintainer": "MintMusic",
      "description": "Audio-only YouTube music player for Linux Mint"
    },
    "publish": {
      "provider": "github",
      "owner": "StuBlueUK",
      "repo": "MintMusic"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "mpris-service": "^2.1.2"
  }
}
